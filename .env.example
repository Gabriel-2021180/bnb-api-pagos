# Copiar a .env y cambiar las contraseñas antes de usar fuera de desarrollo.

# Servicios a levantar: postgres | sqlserver, y opcionalmente kafka
COMPOSE_PROFILES=postgres,kafka

# ---- API ----
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080
SWAGGER_ENABLED=true

# ---- Base de datos que usa la API ----
# PostgreSql -> DB_HOST=postgres  DB_PORT=5432
# SqlServer  -> DB_HOST=sqlserver DB_PORT=1433
DB_PROVIDER=PostgreSql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=apipagos

# Usuario de la aplicación (solo EXECUTE sobre los procedimientos)
APP_DB_USER=apipagos_app
APP_DB_PASSWORD=ApiPagos.App.Dev.2026

# Administradores de cada motor (solo los usan los contenedores de BD)
POSTGRES_OWNER_USER=apipagos_owner
POSTGRES_OWNER_PASSWORD=ApiPagos.Owner.Dev.2026
MSSQL_SA_PASSWORD=ApiPagos.Sa.Dev.2026

# Puertos publicados en el host (para conectarse con un cliente SQL)
POSTGRES_HOST_PORT=5432
SQLSERVER_HOST_PORT=1433
KAFKA_HOST_PORT=9094

# ---- Kafka ----
KAFKA_ENABLED=true
KAFKA_TOPIC=payments.registered

# ---- Seguridad ----
API_KEY_NAME=default-client
API_KEY=cambiar-esta-api-key-0123456789
JWT_SIGNING_KEY=cambiar-esta-clave-de-firma-de-al-menos-32-caracteres
JWT_CLIENT_ID=default-client
JWT_CLIENT_SECRET=cambiar-este-secreto-0123456789
